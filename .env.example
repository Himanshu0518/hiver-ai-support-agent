# ── LLM API Keys ──────────────────────────────────────────────────
# The system falls back: Gemini → Groq → Keywords/Templates.
# At least one key is recommended for best results, but neither is required.

# Google Gemini (primary LLM) — free at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Groq (fast fallback) — free at https://console.groq.com/keys
GROQ_API_KEY=

# ── Optional Model Overrides ──────────────────────────────────────
GEMINI_MODEL=gemini-3.5-flash
GROQ_MODEL=llama-3.3-70b-versatile

# Hugging Face (for embeddings, vector search, reranking)
HF_TOKEN=